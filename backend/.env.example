# CivicBuzz Backend Environment Configuration

APP_ENV=development
APP_NAME=CivicBuzz
API_V1_PREFIX=/api/v1
DEBUG=true

# Security / JWT
SECRET_KEY=civicbuzz-super-secret-key-change-in-production-min32chars!
JWT_SECRET_KEY=civicbuzz-jwt-secret-key-change-in-production-min32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL / PostGIS
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/civicbuzz
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicbuzz
POSTGRES_ECHO=false

# MongoDB Atlas
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=civicbuzz

# Google Maps Platform
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Gemini AI (Google GenAI SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage & Uploads (Local / Cloudinary / S3)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Cloudinary (Optional if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Aadhaar & OTP Providers
AADHAAR_PROVIDER=mock
AADHAAR_SANDBOX_URL=https://stage1.uidai.gov.in/onlineekyc/getAuth/
OTP_PROVIDER=mock
OTP_API_KEY=

# CORS Settings (comma separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:8000,*

# Duplicate Detection & Priority Weights
DUPLICATE_LOCATION_WEIGHT=0.35
DUPLICATE_TEXT_WEIGHT=0.30
DUPLICATE_CATEGORY_WEIGHT=0.15
DUPLICATE_TIME_WEIGHT=0.10
DUPLICATE_IMAGE_WEIGHT=0.10
DUPLICATE_THRESHOLD=0.75
NEARBY_SEARCH_RADIUS_METERS=500.0
